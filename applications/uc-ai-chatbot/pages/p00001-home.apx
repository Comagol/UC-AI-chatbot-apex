page 1 (
    name: UC AI Chatbot
    alias: CHATBOT
    title: UC AI HR Chatbot
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            .uc-ai-conversation { display: flex; flex-direction: column; gap: 10px; padding: 4px 0; min-height: 48px; }
            .uc-ai-bubble { padding: 10px 14px; border-radius: 10px; max-width: 80%; line-height: 1.5; word-wrap: break-word; white-space: pre-wrap; }
            .uc-ai-user  { background: #e3eaf8; align-self: flex-end; text-align: right; }
            .uc-ai-bot   { background: #f0f2f5; align-self: flex-start; }
            .uc-ai-label { display: block; font-size: 0.72rem; font-weight: 700; margin-bottom: 3px; opacity: 0.6; text-transform: uppercase; letter-spacing: .04em; }
            .uc-ai-empty { color: #999; font-style: italic; }
            #send-row    { display: flex; align-items: flex-end; gap: 8px; margin-top: 6px; }
            #send-row textarea { flex: 1; }
            #send-row .t-Button { margin-bottom: 2px; white-space: nowrap; }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb-bar (
        name: UC AI HR Chatbot
        title: UC AI HR Chatbot
        type: staticContent
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/hero
            templateOptions: #DEFAULT#
        }
    )

    region conversation-history (
        name: Conversation
        type: dynamicContent
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        source {
            plsqlFunctionBody:
                ```plsql
                uc_ai_data.render_conversation(:P1_MESSAGES_JSON);
                ```
        }
    )

    region send-message (
        name: Ask a Question
        type: staticContent
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
    )

    pageItem P1_USER_MESSAGE (
        type: textarea
        label {
            label: Your Question
            alignment: above
        }
        layout {
            sequence: 10
            region: @send-message
            slot: regionBody
        }
        appearance {
            height: 4
        }
    )

    pageItem P1_MESSAGES_JSON (
        type: hidden
        layout {
            sequence: 20
            region: @send-message
            slot: regionBody
        }
        sessionState {
            dataType: clob
            storage: session
        }
    )

    button send (
        buttonName: SEND
        label: Send
        layout {
            sequence: 30
            region: @send-message
            slot: regionBody
            startNewRow: false
            columnSpan: 2
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: #DEFAULT#
            icon: fa-paper-plane
        }
        behavior {
            action: submitPage
            warnOnUnsavedChanges: doNotCheck
        }
    )

    process call-uc-ai (
        name: Call UC AI with HR Tools
        type: invokeApi
        execution {
            sequence: 10
            point: processing
        }
        invoke {
            package: UC_AI_DATA
            procedureOrFunction: RUN_CHATBOT
        }
        parameter p_user_message (
            parameter {
                direction: inOut
                dataType: varchar2
                ignoreOutput: false
            }
            value {
                item: P1_USER_MESSAGE
            }
            advanced {
                displaySequence: 1
            }
        )
        parameter p_messages_json (
            parameter {
                direction: inOut
                dataType: clob
                ignoreOutput: false
            }
            value {
                item: P1_MESSAGES_JSON
            }
            advanced {
                displaySequence: 2
            }
        )
        serverSideCondition {
            whenButtonPressed: @send
        }
    )

)

page 1 (
    name: UC AI Chatbot
    alias: CHATBOT
    title: UC AI HR Chatbot
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    css {
        inline:
            ```css
            .uc-ai-conversation { display: flex; flex-direction: column; gap: 10px; padding: 4px 0; min-height: 48px; }
            .uc-ai-bubble { padding: 10px 14px; border-radius: 10px; max-width: 80%; line-height: 1.5; word-wrap: break-word; white-space: pre-wrap; }
            .uc-ai-user  { background: #e3eaf8; align-self: flex-end; text-align: right; }
            .uc-ai-bot-wrap { align-self: flex-start; max-width: 80%; display: flex; flex-direction: column; }
            .uc-ai-bot-wrap .uc-ai-bubble { border-radius: 10px 10px 0 0; max-width: 100%; }
            .uc-ai-bot   { background: #f0f2f5; align-self: flex-start; }
            .uc-ai-label { display: block; font-size: 0.72rem; font-weight: 700; margin-bottom: 3px; opacity: 0.6; text-transform: uppercase; letter-spacing: .04em; }
            .uc-ai-empty { color: #999; font-style: italic; }
            #send-row    { display: flex; align-items: flex-end; gap: 8px; margin-top: 6px; }
            #send-row textarea { flex: 1; }
            #send-row .t-Button { margin-bottom: 2px; white-space: nowrap; }
            /* Token usage badge */
            .uc-ai-usage { display: flex; align-items: center; gap: 16px; padding: 8px 12px; background: #f8f9fa; border: 1px solid #e2e5e9; border-radius: 8px; font-size: 0.82rem; color: #555; flex-wrap: wrap; }
            .uc-ai-usage-label { font-weight: 600; color: #333; white-space: nowrap; }
            .uc-ai-progress-wrap { flex: 1; min-width: 120px; background: #e0e0e0; border-radius: 4px; height: 6px; overflow: hidden; }
            .uc-ai-progress-bar  { height: 100%; border-radius: 4px; transition: width .4s ease; }
            .uc-ai-progress-bar.low    { background: #28a745; }
            .uc-ai-progress-bar.medium { background: #fd7e14; }
            .uc-ai-progress-bar.high   { background: #dc3545; }
            .uc-ai-usage-detail { white-space: nowrap; }
            /* Limit-exceeded inline error */
            .uc-ai-limit-error { display: flex; align-items: flex-start; gap: 10px; padding: 12px 16px; background: #fff3cd; border: 1px solid #ffc107; border-radius: 8px; color: #856404; font-size: 0.9rem; margin-bottom: 6px; }
            .uc-ai-limit-error .uc-ai-limit-icon { font-size: 1.2rem; flex-shrink: 0; }
            /* Per-exchange status bar (reference-style compact line) */
            .uc-ai-status-bar { background: #1a1a1a; color: #f2f2f2; font-size: 0.68rem; font-weight: 500; padding: 6px 11px; border-radius: 0 0 8px 8px; line-height: 1.45; letter-spacing: 0.01em; }
            .uc-ai-status-sep { opacity: 0.45; margin: 0 5px; }
            ```
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb-bar (
        name: UC AI HR Chatbot
        title: UC AI HR Chatbot
        type: staticContent
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/hero
            templateOptions: #DEFAULT#
        }
    )

    region token-usage-badge (
        name: Daily Token Usage
        type: dynamicContent
        layout {
            sequence: 15
            slot: body
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        source {
            plsqlFunctionBody:
                ```plsql
                declare
                  l_u  json_object_t := uc_ai_data.get_usage_summary('DAILY');
                  l_pct     number        := nvl(l_u.get_number('pct_used'), 0);
                  l_used    number        := nvl(l_u.get_number('tokens_used'), 0);
                  l_limit   number        := nvl(l_u.get_number('tokens_limit'), 0);
                  l_req_u   number        := nvl(l_u.get_number('requests_used'), 0);
                  l_req_l   number        := nvl(l_u.get_number('requests_limit'), 0);
                  l_bar_cls varchar2(10)  := case
                                               when l_pct >= 90 then 'high'
                                               when l_pct >= 60 then 'medium'
                                               else                   'low'
                                             end;
                  l_pct_disp varchar2(10) := to_char(least(l_pct, 100), 'FM990D0') || '%';
                begin
                  if l_limit = 0 then
                    return null;
                  end if;
                  htp.p('<div class="uc-ai-usage">');
                  htp.p('<span class="uc-ai-usage-label">&#128221; Today''s usage</span>');
                  htp.p('<div class="uc-ai-progress-wrap">');
                  htp.p('<div class="uc-ai-progress-bar ' || l_bar_cls || '" style="width:' ||
                        to_char(least(l_pct, 100), 'FM990D0') || '%"></div>');
                  htp.p('</div>');
                  htp.p('<span class="uc-ai-usage-detail">');
                  htp.p(apex_escape.html(to_char(l_used, 'FM999G999G999')) ||
                        ' / ' || apex_escape.html(to_char(l_limit, 'FM999G999G999')) ||
                        ' tokens (' || l_pct_disp || ')');
                  htp.p('</span>');
                  if l_req_l > 0 then
                    htp.p('<span class="uc-ai-usage-detail" style="color:#777;">');
                    htp.p(apex_escape.html(to_char(l_req_u)) || ' / ' ||
                          apex_escape.html(to_char(l_req_l)) || ' requests');
                    htp.p('</span>');
                  end if;
                  htp.p('</div>');
                end;
                ```
        }
    )

    region conversation-history (
        name: Conversation
        type: dynamicContent
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        source {
            plsqlFunctionBody:
                ```plsql
                uc_ai_data.render_conversation(:P1_MESSAGES_JSON);
                ```
        }
    )

    region limit-error-banner (
        name: Limit Error
        type: dynamicContent
        layout {
            sequence: 25
            slot: body
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        source {
            plsqlFunctionBody:
                ```plsql
                declare
                  l_msg varchar2(32767) := :P1_LIMIT_ERROR;
                begin
                  if l_msg is not null then
                    htp.p('<div class="uc-ai-limit-error">');
                    htp.p('<span class="uc-ai-limit-icon">&#9888;&#65039;</span>');
                    htp.p('<span>' || apex_escape.html(l_msg) || '</span>');
                    htp.p('</div>');
                  end if;
                end;
                ```
        }
    )

    region send-message (
        name: Ask a Question
        type: staticContent
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
    )

    pageItem P1_LIMIT_ERROR (
        type: hidden
        layout {
            sequence: 5
            region: @send-message
            slot: regionBody
        }
        sessionState {
            storage: session
        }
    )

    pageItem P1_USER_MESSAGE (
        type: textarea
        label {
            label: Your Question
            alignment: above
        }
        layout {
            sequence: 10
            region: @send-message
            slot: regionBody
        }
        appearance {
            height: 4
        }
    )

    pageItem P1_MESSAGES_JSON (
        type: hidden
        layout {
            sequence: 20
            region: @send-message
            slot: regionBody
        }
        sessionState {
            dataType: clob
            storage: session
        }
    )

    button send (
        buttonName: SEND
        label: Send
        layout {
            sequence: 30
            region: @send-message
            slot: regionBody
            startNewRow: false
            columnSpan: 2
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: #DEFAULT#
            icon: fa-paper-plane
        }
        behavior {
            action: submitPage
            warnOnUnsavedChanges: doNotCheck
        }
    )

    process clear-limit-error (
        name: Clear Previous Limit Error
        type: executeCode
        execution {
            sequence: 5
            point: processing
        }
        source {
            language: plsql
            plsqlCode:
                ```plsql
                :P1_LIMIT_ERROR := null;
                ```
        }
        serverSideCondition {
            whenButtonPressed: @send
        }
    )

    process call-uc-ai (
        name: Call UC AI with HR Tools
        type: executeCode
        execution {
            sequence: 10
            point: processing
        }
        source {
            language: plsql
            plsqlCode:
                ```plsql
                begin
                  uc_ai_data.run_chatbot(
                    p_user_message  => :P1_USER_MESSAGE,
                    p_messages_json => :P1_MESSAGES_JSON
                  );
                exception
                  when uc_ai_data.e_token_limit_exceeded then
                    :P1_LIMIT_ERROR := replace(sqlerrm, 'ORA-20101: ', '');
                end;
                ```
        }
        serverSideCondition {
            whenButtonPressed: @send
        }
    )

)
